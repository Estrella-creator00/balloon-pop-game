{
  "name": "poppop-ranking-functions",
  "private": true,
  "engines": {
    "node": "22"
  },
  "main": "lib/src/index.js",
  "scripts": {
    "build": "tsc",
    "lint": "eslint .",
    "test": "npm run build && node --test lib/test/*.test.js",
    "test:rules": "npm run build && firebase emulators:exec --only firestore --project demo-poppop --config ../firebase.rules-test.json \"node --test lib/test/firestore-rules.test.js\"",
    "migrate": "npm run build && node lib/scripts/migrate-v1-to-v2.js",
    "delete-user": "npm run build && node lib/scripts/delete-user.js"
  },
  "dependencies": {
    "@google-cloud/functions-framework": "^5.0.5",
    "firebase-admin": "^13.4.0",
    "firebase-functions": "^6.4.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.28.0",
    "@firebase/rules-unit-testing": "^4.0.1",
    "@types/node": "^22.15.29",
    "eslint": "^9.28.0",
    "firebase-tools": "^14.7.0",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.33.0"
  }
}
